# Kopiér til .env.local, når du kører lokalt. På Vercel lægger du dem ind under
# Project → Settings → Environment Variables. Læg aldrig rigtige nøgler i Git.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# LiveKit Cloud → Settings → Keys (hemmelig: kun på serveren)
LIVEKIT_URL=wss://xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxx

# Sidens adresse (bruges til links i login-mails og til SEO)
NEXT_PUBLIC_SITE_URL=https://snuplive.dk

# ── Betaling (trin 2) ──
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Kun på serveren!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Stripe → Developers → API keys → Secret key (sk_test_… i testmiljøet)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Stripe → Developers → Webhooks → dit endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Valgfri: signing secret for et ekstra endpoint til "Connected accounts"
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxx
# Et langt tilfældigt kodeord, som beskytter det daglige oprydningsjob
CRON_SECRET=lav-et-langt-tilfaeldigt-kodeord
